# Browser-safe values (safe to expose in VITE_ variables)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Local admin provisioning ONLY. Never add these to Vercel frontend variables or GitHub.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ADMIN_INITIAL_PASSWORD=Admin@123
DEMO_STUDENT_PASSWORD=DemoStudent@123

# Gemini AI assistant (server-side only; NEVER use a VITE_ prefix)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
